<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 后台刷新。BGTaskScheduler 要求这个标识符必须在这里登记，
	     否则 submit() 直接抛异常，后台任务永远不会跑。 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
		<!-- 静音音频保活：构建在跑时循环播一段静音，
		     系统据此认定 App 在做音频播放，不会挂起进程。 -->
		<string>audio</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>org.example.buildlight.refresh</string>
	</array>
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconName</key>
			<string>AppIcon</string>
		</dict>
		<key>CFBundleAlternateIcons</key>
		<dict>
			<key>AppIcon-Indigo</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Indigo</string>
			</dict>
			<key>AppIcon-Violet</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Violet</string>
			</dict>
			<key>AppIcon-Rose</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Rose</string>
			</dict>
			<key>AppIcon-Teal</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Teal</string>
			</dict>
			<key>AppIcon-Pine</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Pine</string>
			</dict>
			<key>AppIcon-Lime</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Lime</string>
			</dict>
			<key>AppIcon-Copper</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon-Copper</string>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
